# ── Banco de dados (obrigatório) ─────────────────────────────────────
# No Supabase: Project Settings → Database → Connection string → aba "Connection pooling"
# (é a que tem pooler.supabase.com e porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
# Use a mesma string na Vercel (Environment Variables → DATABASE_URL).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Opcionais ───────────────────────────────────────────────────────
# Senha inicial do acesso ao painel (padrão: mary-lanches-2026 — troque no painel depois)
# ADMIN_PASSWORD=
# Qual estabelecimento abre na raiz do site (padrão: o único cadastrado)
# DEFAULT_ESTABLISHMENT_SLUG=mary-delivery
